{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"],
      "description": "Gives Claude Code scoped read/write access to src/ only"
    },
    "mysql": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "${DB_HOST}",
        "MYSQL_PORT": "${DB_PORT}",
        "MYSQL_USER": "${DB_USER}",
        "MYSQL_PASS": "${DB_PASSWORD}",
        "MYSQL_DB":   "${DB_NAME}"
      },
      "description": "Lets Claude query MySQL directly for debugging — read-only recommended"
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API access — used by pr-opener subagent for create_pull_request, list_pull_requests, etc."
    }
  }
}
